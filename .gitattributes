# Line endings: LF everywhere (the library runs on Linux), CRLF only for
# files Windows runs.  Applies on every checkout regardless of core.autocrlf.
* text=auto eol=lf
*.sh text eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.ico   binary
*.svg   binary
*.pdf   binary
*.zip   binary
*.gz    binary
*.woff  binary
*.woff2 binary
*.ttf   binary
